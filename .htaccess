# Mesmos cabeçalhos do vercel.json (produção). Mudou um, mude o outro.

<IfModule mod_headers.c>
  # CSS, JS, fontes e imagens: cache imutável de 1 ano (os links levam ?v=)
  <FilesMatch "\.(css|js|woff2|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML sempre revalidado, como a Vercel faz por padrão
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; frame-src https://www.google.com https://maps.google.com; connect-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self';"
  Header set Strict-Transport-Security "max-age=31536000"
  Header set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml application/xml text/plain
</IfModule>
